# ─── Copy to .env and fill in. Never commit real values. ───

# Core
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/christian_platform?schema=public

# Authentication (Better Auth). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-random-bytes
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated extra trusted origins (mobile scheme is added automatically)
TRUSTED_ORIGINS=
# Google OAuth is enabled only when both server-side values are configured.
# Register /api/auth/callback/google on your real application origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption key for private prayers & notes (32 bytes, base64). Generate with: openssl rand -base64 32
# Losing or rotating this key without migration makes existing entries unreadable.
PERSONAL_DATA_KEY=replace-with-base64-32-bytes

# Email (verification & password reset). If unset in development, links are logged to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="RUAH <no-reply@example.org>"

# Scripture providers
# YouVersion Platform: register HINENI and accept the required edition licenses.
# Server-only App Key; do not put the real key in source code or chat.
YVP_APP_KEY=
# Verify AB2004 (YouVersion edition 369) with:
# npm exec -- dotenv -e .env -- node scripts/check-youversion-access.mjs
# This check does not enable Scripture display or establish edition availability by itself.
# bible-api.com serves public-domain translations (WEB, KJV) and needs no key.
# API.Bible (https://scripture.api.bible) provides licensed translations incl. Mongolian; requires an approved key.
API_BIBLE_KEY=
# Comma-separated list of id:language:API.Bible bibleId entries to enable, e.g. mn-bible:mn:xxxxxxxxxxxxxxxx-01
API_BIBLE_TRANSLATIONS=
# Set only after documenting the product's display rights and API.Bible terms.
API_BIBLE_RIGHTS_CONFIRMED=false
# MonKJV is NT-only; public API accessibility is not proof of RUAH distribution rights.
# Enable only after obtaining written rights from the copyright holder.
MONGOLIAN_BIBLE_RIGHTS_CONFIRMED=false

# Maps (church directory). OpenStreetMap tiles are used by default; respect their usage policy in production.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
# Geocoding for church submissions (Nominatim by default; set a contact email per its policy)
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_EMAIL=

# Media uploads (admin). Local disk by default.
UPLOAD_DIR=./uploads

# Branding (optional overrides — the name is not final)
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_NAME_MN=

# Seeding: promote an already-registered account to ADMIN
SEED_ADMIN_EMAIL=
