{
  "name": "@cp/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev",
    "build": "dotenv -e ../../.env -- node ../../scripts/build-web.mjs",
    "start": "dotenv -e ../../.env -- next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "dotenv -e ../../.env -- playwright test",
    "vercel-build": "prisma generate --schema ../../packages/db/prisma/schema.prisma && next build"
  },
  "dependencies": {
    "@cp/db": "*",
    "@cp/shared": "*",
    "better-auth": "^1.7.7",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
