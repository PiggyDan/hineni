{
  "name": "christian-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @cp/web",
    "build": "npm run build -w @cp/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "dotenv -e .env -- node tests/integration/foundation.mjs",
    "db:validate": "npm run validate -w @cp/db",
    "db:generate": "npm run generate -w @cp/db",
    "db:migrate": "npm run migrate:dev -w @cp/db",
    "db:deploy": "npm run migrate:deploy -w @cp/db",
    "db:seed": "npm run seed -w @cp/db",
    "test:integration:redesign": "dotenv -e .env -- node tests/integration/redesign.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.18": true
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "deepmerge-ts": "8.0.2"
  }
}
